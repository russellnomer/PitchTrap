# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
PORT=5000

# Encryption key for storing user provider credentials (generate a strong 32+ char key)
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-very-long-random-string

# Stripe (for activation fee + subscription)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ACTIVATION_PRICE_ID=price_...
STRIPE_SUBSCRIPTION_PRICE_ID=price_...

# Optional – used only if you want a fallback system-level provider for demos
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SIGNALWIRE_PROJECT_ID=
# SIGNALWIRE_API_TOKEN=
# SIGNALWIRE_SPACE_URL=
